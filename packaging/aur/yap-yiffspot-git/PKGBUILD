# Maintainer: Syth <git@sythron.gay>
pkgname=yap-yiffspot-git
_name=yap
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Terminal client for YiffSpot, the anonymous furry roleplay chat (18+) (latest commit)"
arch=('x86_64' 'aarch64')
url="https://github.com/SythsSludge/yap"
license=('MIT')
depends=('gcc-libs' 'glibc')
# makepkg's C LTO flags produce objects the Rust linker can't read (ring's C code).
options=('!lto')
makedepends=('cargo' 'git')
optdepends=('hunspell-en_gb: British English spellcheck (or any other hunspell dictionary)'
            'pipewire-audio: notification sounds (pw-play)')
provides=('yap-yiffspot')
conflicts=('yap' 'yap-bin' 'yap-git' 'yap-yiffspot')
source=("$_name::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_name"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$_name"
  make install DESTDIR="$pkgdir" PREFIX=/usr CARGOFLAGS=--frozen
  # Arch keeps licences under the package name.
  mv "$pkgdir/usr/share/licenses/yap" "$pkgdir/usr/share/licenses/$pkgname"
}
